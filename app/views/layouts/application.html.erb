<!DOCTYPE html>
<html>
  <head>
    <title>TwitterClone - Red Social</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <!-- Favicons will be added later -->

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>

  <body class="bg-light">
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
      <div class="container">
        <%= link_to (user_signed_in? ? authenticated_root_path : root_path), class: "navbar-brand fw-bold" do %>
          <i class="fab fa-twitter me-2"></i>TwitterClone
        <% end %>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto">
            <% if user_signed_in? %>
              <li class="nav-item">
                <%= link_to "Inicio", authenticated_root_path, class: "nav-link #{'active' if current_page?(authenticated_root_path)}" %>
              </li>
              <li class="nav-item">
                <%= link_to "Mis Tweets", twitters_path(user: current_user.username), class: "nav-link" %>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to "Inicio", root_path, class: "nav-link #{'active' if current_page?(root_path)}" %>
              </li>
            <% end %>
          </ul>

          <!-- Search form - Only for authenticated users -->
          <% if user_signed_in? %>
            <%= form_with url: twitters_path, method: :get, class: "d-flex me-3", local: true do |f| %>
              <%= f.text_field :query_text, placeholder: "Buscar tweets...", 
                              value: params[:query_text], 
                              class: "form-control form-control-sm me-2", style: "width: 250px;" %>
              <%= f.submit "Buscar", class: "btn btn-outline-light btn-sm" %>
            <% end %>
          <% end %>

          <!-- User menu -->
          <ul class="navbar-nav">
            <% if user_signed_in? %>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                  <i class="fas fa-user-circle me-1"></i>
                  <%= current_user.display_name %>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li><h6 class="dropdown-header"><%= current_user.full_name %></h6></li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= link_to new_twitter_path, class: "dropdown-item" do %>
                      <i class="fas fa-plus me-2"></i>Nuevo Tweet
                    <% end %>
                  </li>
                  <li>
                    <%= link_to edit_user_registration_path, class: "dropdown-item" do %>
                      <i class="fas fa-cog me-2"></i>Configuración
                    <% end %>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= link_to destroy_user_session_path, method: :delete, class: "dropdown-item text-danger" do %>
                      <i class="fas fa-sign-out-alt me-2"></i>Cerrar Sesión
                    <% end %>
                  </li>
                </ul>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to "Iniciar Sesión", new_user_session_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Registrarse", new_user_registration_path, class: "btn btn-outline-light ms-2" %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Flash messages -->
    <% if notice %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i><%= notice %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>

    <% if alert %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i><%= alert %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>

    <!-- Main content -->
    <main class="<%= user_signed_in? ? 'container my-4' : '' %>">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light text-center py-3 mt-5">
      <div class="container">
        <p class="mb-0">&copy; <%= Date.current.year %> TwitterClone. Hecho con ❤️ usando Ruby on Rails.</p>
      </div>
    </footer>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
