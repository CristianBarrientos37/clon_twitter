<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card shadow-sm">
      <div class="card-header bg-primary text-white text-center">
        <h3 class="mb-0">
          <i class="fab fa-twitter me-2"></i>
          Únete a TwitterClone
        </h3>
      </div>
      
      <div class="card-body p-4">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), 
                    html: { class: "needs-validation", novalidate: true }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <!-- First Name -->
          <div class="mb-3">
            <%= f.label :first_name, "Nombre", class: "form-label" %>
            <%= f.text_field :first_name, autofocus: true, class: "form-control", 
                placeholder: "Tu nombre", required: true, maxlength: 50 %>
            <div class="invalid-feedback">
              Por favor ingresa tu nombre.
            </div>
          </div>

          <!-- Last Name -->
          <div class="mb-3">
            <%= f.label :last_name, "Apellido", class: "form-label" %>
            <%= f.text_field :last_name, class: "form-control", 
                placeholder: "Tu apellido", required: true, maxlength: 50 %>
            <div class="invalid-feedback">
              Por favor ingresa tu apellido.
            </div>
          </div>

          <!-- Username -->
          <div class="mb-3">
            <%= f.label :username, "Nombre de usuario", class: "form-label" %>
            <div class="input-group">
              <span class="input-group-text">@</span>
              <%= f.text_field :username, class: "form-control", 
                  placeholder: "nombreusuario", required: true, maxlength: 25,
                  pattern: "[a-zA-Z0-9_]+", title: "Solo letras, números y guiones bajos" %>
            </div>
            <div class="form-text">
              Solo letras, números y guiones bajos. Mínimo 3 caracteres.
            </div>
            <div class="invalid-feedback">
              Ingresa un nombre de usuario válido (3-25 caracteres).
            </div>
          </div>

          <!-- Email -->
          <div class="mb-3">
            <%= f.label :email, "Correo electrónico", class: "form-label" %>
            <%= f.email_field :email, autocomplete: "email", class: "form-control", 
                placeholder: "tu@email.com", required: true %>
            <div class="invalid-feedback">
              Por favor ingresa un email válido.
            </div>
          </div>

          <!-- Password -->
          <div class="mb-3">
            <%= f.label :password, "Contraseña", class: "form-label" %>
            <%= f.password_field :password, autocomplete: "new-password", 
                class: "form-control", placeholder: "Mínimo 6 caracteres", 
                required: true, minlength: 6 %>
            <% if @minimum_password_length %>
              <div class="form-text">
                Mínimo <%= @minimum_password_length %> caracteres.
              </div>
            <% end %>
            <div class="invalid-feedback">
              La contraseña debe tener al menos 6 caracteres.
            </div>
          </div>

          <!-- Password Confirmation -->
          <div class="mb-4">
            <%= f.label :password_confirmation, "Confirmar contraseña", class: "form-label" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", 
                class: "form-control", placeholder: "Repite tu contraseña", required: true %>
            <div class="invalid-feedback">
              Las contraseñas no coinciden.
            </div>
          </div>

          <!-- Submit Button -->
          <div class="d-grid mb-3">
            <%= f.submit "Crear cuenta", class: "btn btn-primary btn-lg" %>
          </div>
        <% end %>

        <!-- Links -->
        <div class="text-center">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>

    <!-- Benefits -->
    <div class="card mt-4">
      <div class="card-body">
        <h6 class="card-title">
          <i class="fas fa-star text-warning me-2"></i>
          ¿Por qué unirte?
        </h6>
        <ul class="small text-muted mb-0">
          <li>Comparte tus pensamientos con el mundo</li>
          <li>Conecta con personas interesantes</li>
          <li>Mantente al día con las últimas tendencias</li>
          <li>Interfaz moderna y fácil de usar</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Custom form validation
  const forms = document.querySelectorAll('.needs-validation');
  const passwordField = document.querySelector('input[name="user[password]"]');
  const passwordConfirmField = document.querySelector('input[name="user[password_confirmation]"]');

  Array.prototype.slice.call(forms).forEach(function(form) {
    form.addEventListener('submit', function(event) {
      // Check if passwords match
      if (passwordField.value !== passwordConfirmField.value) {
        passwordConfirmField.setCustomValidity('Las contraseñas no coinciden');
      } else {
        passwordConfirmField.setCustomValidity('');
      }

      if (!form.checkValidity()) {
        event.preventDefault();
        event.stopPropagation();
      }

      form.classList.add('was-validated');
    }, false);
  });

  // Real-time password confirmation check
  if (passwordConfirmField) {
    passwordConfirmField.addEventListener('input', function() {
      if (this.value !== passwordField.value) {
        this.setCustomValidity('Las contraseñas no coinciden');
      } else {
        this.setCustomValidity('');
      }
    });
  }
});
</script>
