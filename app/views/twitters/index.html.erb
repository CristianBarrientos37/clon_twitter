<div class="row">
  <div class="col-lg-8 mx-auto">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="h3 mb-0">
        <i class="fas fa-home me-2 text-primary"></i>
        Inicio
      </h1>
      <%= link_to new_twitter_path, class: "btn btn-primary" do %>
        <i class="fas fa-feather-alt me-2"></i>Tweetear
      <% end %>
    </div>

    <!-- Search results info -->
    <% if params[:query_text].present? %>
      <div class="alert alert-info">
        <i class="fas fa-search me-2"></i>
        Resultados para: <strong>"<%= params[:query_text] %>"</strong>
        <%= link_to "Ver todos los tweets", twitters_path, class: "btn btn-sm btn-outline-primary ms-2" %>
      </div>
    <% end %>

    <!-- Tweet list -->
    <div class="card shadow-sm">
      <div class="card-body p-0">
        <% if @twitters.any? %>
          <% @twitters.each_with_index do |twitter, index| %>
            <div class="tweet-card p-4 <%= 'border-bottom' unless index == @twitters.count - 1 %>">
              <div class="d-flex">
                <!-- Avatar -->
                <div class="me-3">
                  <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" 
                       style="width: 48px; height: 48px; font-size: 18px;">
                    <%= twitter.user.first_name[0].upcase %>
                  </div>
                </div>

                <!-- Tweet content -->
                <div class="flex-grow-1">
                  <!-- User info -->
                  <div class="d-flex align-items-center mb-2">
                    <strong class="me-2"><%= twitter.author_name %></strong>
                    <span class="text-muted me-2"><%= twitter.author_username %></span>
                    <span class="text-muted">·</span>
                    <span class="text-muted ms-2" title="<%= twitter.created_at.strftime('%d/%m/%Y %H:%M') %>">
                      <%= twitter.time_ago %>
                    </span>
                  </div>

                  <!-- Tweet text -->
                  <div class="tweet-content mb-3">
                    <%= simple_format(twitter.description, {}, wrapper_tag: "div") %>
                  </div>

                  <!-- Actions -->
                  <div class="tweet-actions d-flex align-items-center">
                    <%= link_to twitter, class: "btn btn-sm btn-outline-secondary me-2" do %>
                      <i class="fas fa-eye me-1"></i>Ver
                    <% end %>
                    
                    <% if current_user == twitter.user %>
                      <%= link_to edit_twitter_path(twitter), class: "btn btn-sm btn-outline-primary me-2" do %>
                        <i class="fas fa-edit me-1"></i>Editar
                      <% end %>
                      
                      <%= link_to twitter, method: :delete, 
                                  confirm: "¿Estás seguro de que quieres eliminar este tweet?",
                                  class: "btn btn-sm btn-outline-danger" do %>
                        <i class="fas fa-trash me-1"></i>Eliminar
                      <% end %>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="text-center py-5">
            <i class="fas fa-twitter text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted">No hay tweets aún</h4>
            <p class="text-muted">
              <% if params[:query_text].present? %>
                No se encontraron tweets que coincidan con tu búsqueda.
              <% else %>
                ¡Sé el primero en compartir algo!
              <% end %>
            </p>
            <% unless params[:query_text].present? %>
              <%= link_to new_twitter_path, class: "btn btn-primary" do %>
                <i class="fas fa-feather-alt me-2"></i>Escribir primer tweet
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Pagination -->
    <% if @pagy.pages > 1 %>
      <div class="d-flex justify-content-center mt-4">
        <%== pagy_bootstrap_nav(@pagy) if defined?(pagy_bootstrap_nav) %>
      </div>
    <% end %>
  </div>
</div>

<style>
  .tweet-card:hover {
    background-color: #f8f9fa;
    transition: background-color 0.2s ease;
  }

  .avatar {
    font-weight: bold;
  }

  .tweet-content {
    line-height: 1.5;
    word-wrap: break-word;
  }

  .tweet-actions .btn {
    font-size: 0.875rem;
  }
</style>



